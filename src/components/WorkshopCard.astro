---
// src/components/WorkshopCard.astro
interface Props {
  image: string;
  title: string;
  date: string;
  description: string;
  price: string;
}

const { image, title, date, description, price } = Astro.props;
---

<article class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-[#e6dfd3]/40 flex flex-col h-full">
  <div class="overflow-hidden relative aspect-[4/3]">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
    />
    <span class="absolute top-4 right-4 bg-[#faf7f2]/90 backdrop-blur-sm text-[#2c4a3e] font-medium text-xs tracking-wider uppercase px-3 py-1.5 rounded-full border border-[#e6dfd3]">
      {price}
    </span>
  </div>
  
  <div class="p-6 md:p-8 flex flex-col flex-grow">
    <time class="text-xs font-semibold tracking-widest text-[#c97d60] uppercase block mb-2">{date}</time>
    <h3 class="text-xl md:text-2xl text-[#2c4a3e] font-normal leading-tight mb-3 group-hover:text-[#c97d60] transition-colors">
      {title}
    </h3>
    <p class="text-sm md:text-base text-[#6b6152] font-light leading-relaxed flex-grow">
      {description}
    </p>
    
    <div class="mt-6 pt-4 border-t border-[#faf7f2] flex items-center text-sm font-medium text-[#2c4a3e] group-hover:translate-x-1 transition-transform duration-300">
      Saber más e inscribirse 
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 ml-1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </div>
  </div>
</article>